  "exceptions": [
    {
      "id": "RC_REQUIRED",
      "appliesTo": [
        "RELAYCORE_GPT_6_1_SOL",
        "RELAYCORE_GPT_6_ASTRA"
      ],
      "contract": "docs/RELAYCORE_MODEL_CURRENT_CONTRACT.md",
      "rule": "Sol/Astra普通文字Responses使用required、external_web_access=true及include web_search_call.action.sources；附件路径遵循RC_COMPANION，真实来源和返回身份分别验证。"
    },
    {
      "id": "RC_COMPANION",
      "appliesTo": [
        "RELAYCORE_OPUS_5_5",
        "RELAYCORE_SONNET_5_5",
        "RELAYCORE_GPT_6_1_SOL",
        "RELAYCORE_GPT_6_ASTRA",
        "RELAYCORE_GEMINI_3_8_FLASH",
        "RELAYCORE_GEMINI_3_1_PRO"
      ],
      "contract": "docs/RELAYCORE_MODEL_CURRENT_CONTRACT.md",
      "rule": "普通文字Sol/Astra自身Responses，其余四款及RC六款联网附件由固定OpenRouter Luna原生检索后交回原模型；准确接收方／材料授权，来源、不同币种用量及失败分别保留。"
    },
    {
      "id": "RC_CLAUDE_EFFORT",
      "appliesTo": [
        "RELAYCORE_OPUS_5_5",
        "RELAYCORE_SONNET_5_5"
      ],
      "contract": "docs/RELAYCORE_MODEL_CURRENT_CONTRACT.md",
      "rule": "普通Messages SSE；Opus medium、Sonnet high，system与完整原材料保留。"
    },
    {
      "id": "RC_OPUS_ALIAS",
      "appliesTo": [
        "RELAYCORE_OPUS_5_5"
      ],
      "contract": "docs/RELAYCORE_MODEL_CURRENT_CONTRACT.md",
      "rule": "唯一已验同组别名：claude-opus-5-5→claude-opus-5.5；不是运行时自动fallback。"
    },
    {
      "id": "RC_ASTRA_ADAPTIVE",
      "appliesTo": [
        "RELAYCORE_GPT_6_ASTRA"
      ],
      "contract": "docs/RELAYCORE_MODEL_CURRENT_CONTRACT.md",
      "rule": "简单查询low，复杂查询medium，effort与搜索上下文一致，模型身份保持。"
    },
    {
      "id": "OR_OPUS_MEDIUM",
      "appliesTo": [
        "CLAUDE_OPUS_5_5"
      ],
      "contract": "docs/P6G_MODEL_SELECTION_AUTO_ROUTER_CONTRACT.md",
      "rule": "OpenRouter reasoning.effort=medium；不套RC的output_config参数。"
    },
    {
      "id": "OR_HIGH",
      "appliesTo": [
        "CLAUDE_SONNET_5_5",
        "GPT_6_1_SOL"
      ],
      "contract": "docs/P6G_MODEL_SELECTION_AUTO_ROUTER_CONTRACT.md",
      "rule": "当前OpenRouter默认high；联网不能删除reasoning字段。"
    },
    {
      "id": "QWEN_MAX",
      "appliesTo": [
        "QWEN_3_8_MAX"
      ],
      "contract": "docs/C12_MODEL_NETWORK_PARITY_CONTRACT.md",
      "rule": "Responses enable_thinking=true、reasoning low，上限16384；离线字段由Qwen适配器处理。"
    },
    {
      "id": "GLM_BUDGET",
      "appliesTo": [
        "GLM_5_3",
        "GLM_5_3_FLASH"
      ],
      "contract": "docs/C12_MODEL_NETWORK_PARITY_CONTRACT.md",
      "rule": "thinking enabled；内部显式附件检索low，原选最终回答及普通请求max（C12）；Mac输出预算32768，Android受当前profile约束，预算不冒充用量。"
    },
    {
      "id": "ZHIPU_SCOPE",
      "appliesTo": [
        "GLM_5_3",
        "GLM_5_3_FLASH"
      ],
      "contract": "docs/C12_MODEL_NETWORK_PARITY_CONTRACT.md",
      "rule": "附件要点作为search_query；关闭意图分支并要求实际搜索及来源。"
    },
    {
      "id": "DEEPSEEK_MESSAGES",
      "appliesTo": [
        "DEEPSEEK_V4_PRO",
        "DEEPSEEK_V4_FLASH"
      ],
      "contract": "docs/C12_MODEL_NETWORK_PARITY_CONTRACT.md",
      "rule": "联网走anthropic Messages原生搜索，单请求5–12次；离线仍Chat Completions。"
    },
    {
      "id": "RC_CNY",
      "appliesTo": [
        "RELAYCORE_OPUS_5_5",
        "RELAYCORE_SONNET_5_5",
        "RELAYCORE_GPT_6_1_SOL",
        "RELAYCORE_GPT_6_ASTRA",
        "RELAYCORE_GEMINI_3_8_FLASH",
