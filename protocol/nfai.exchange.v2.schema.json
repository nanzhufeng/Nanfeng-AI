{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanzhufeng.com/schemas/nfai.exchange.v2.json",
  "title": "Nanfeng AI owner-fidelity exchange v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "export", "projects", "conversations", "knowledge", "memory", "relations", "settings"],
  "properties": {
    "format": { "const": "nfai.exchange" }, "version": { "const": 2 }, "export": { "$ref": "#/$defs/export" },
    "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
    "conversations": { "type": "array", "items": { "$ref": "#/$defs/conversation" } },
    "knowledge": { "type": "array", "items": { "$ref": "#/$defs/knowledge" } },
    "memory": { "type": "array", "items": { "$ref": "#/$defs/memory" } },
    "relations": { "type": "array", "items": { "$ref": "#/$defs/relation" } }, "settings": { "$ref": "#/$defs/settings" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$" }, "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "instant": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$" }, "revision": { "type": "integer", "minimum": 0 },
    "export": { "type": "object", "additionalProperties": false, "required": ["id", "createdAt", "origin", "semanticHash", "sensitivity"], "properties": { "id": { "$ref": "#/$defs/id" }, "createdAt": { "$ref": "#/$defs/instant" }, "origin": { "type": "object", "additionalProperties": false, "required": ["platform", "appVersion"], "properties": { "platform": { "enum": ["ANDROID", "DESKTOP"] }, "appVersion": { "type": "string", "maxLength": 80 } } }, "semanticHash": { "$ref": "#/$defs/hash" }, "sensitivity": { "enum": ["NORMAL", "HIGH_SENSITIVE"] } } },
    "project": { "type": "object", "additionalProperties": false, "required": ["id", "title", "description", "appearance", "pinned", "archived", "createdAt", "updatedAt", "schemaVersion", "instructionHistory"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "description": { "type": "string" }, "appearance": { "type": "object", "additionalProperties": false, "required": ["color", "icon"], "properties": { "color": { "enum": ["FOREST", "OCEAN", "AMBER", "PLUM", "SLATE", null] }, "icon": { "enum": ["FOLDER", "BOOKMARK", "COMPASS", "SPARK", "GRID", null] } } }, "pinned": { "type": "boolean" }, "archived": { "type": "boolean" }, "createdAt": { "$ref": "#/$defs/instant" }, "updatedAt": { "$ref": "#/$defs/instant" }, "schemaVersion": { "$ref": "#/$defs/revision" }, "instructionHistory": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["id", "revision", "content", "source", "contentHash", "createdAt", "schemaVersion"], "properties": { "id": { "$ref": "#/$defs/id" }, "revision": { "$ref": "#/$defs/revision" }, "content": { "type": "string" }, "source": { "const": "USER" }, "contentHash": { "$ref": "#/$defs/hash" }, "createdAt": { "$ref": "#/$defs/instant" }, "schemaVersion": { "$ref": "#/$defs/revision" } } } } } },
    "conversation": { "type": "object", "additionalProperties": false, "required": ["id", "projectId", "title", "currentLeafId", "pinned", "archived", "revision", "createdAt", "updatedAt", "autoTitlePending", "surface", "schemaVersion", "settings", "messages"], "properties": { "id": { "$ref": "#/$defs/id" }, "projectId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "title": { "type": "string" }, "currentLeafId": { "$ref": "#/$defs/id" }, "pinned": { "type": "boolean" }, "archived": { "type": "boolean" }, "revision": { "$ref": "#/$defs/revision" }, "createdAt": { "$ref": "#/$defs/instant" }, "updatedAt": { "$ref": "#/$defs/instant" }, "autoTitlePending": { "type": "boolean" }, "surface": { "const": "CHAT" }, "schemaVersion": { "$ref": "#/$defs/revision" }, "settings": { "type": "object", "additionalProperties": false, "required": ["defaultProviderId", "defaultModelId", "harnessId", "harnessVersion", "contextPolicyVersion", "memorySources", "schemaVersion"], "properties": { "defaultProviderId": { "anyOf": [{ "enum": ["MOCK", "OPENROUTER"] }, { "type": "null" }] }, "defaultModelId": { "type": ["string", "null"] }, "harnessId": { "type": ["string", "null"] }, "harnessVersion": { "type": ["integer", "null"] }, "contextPolicyVersion": { "$ref": "#/$defs/revision" }, "memorySources": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["memoryId", "sourceKind", "sourceVersion"], "properties": { "memoryId": { "$ref": "#/$defs/id" }, "sourceKind": { "type": "string" }, "sourceVersion": { "$ref": "#/$defs/revision" } } } }, "schemaVersion": { "$ref": "#/$defs/revision" } } }, "messages": { "type": "array" } } },
    "knowledge": { "type": "object", "additionalProperties": false, "required": ["id", "title", "body", "sourceEvidence", "provenance", "attachments", "status", "scope", "projectId", "tags", "contentHash", "createdAt", "updatedAt", "schemaVersion", "history"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "body": { "type": "string" }, "sourceEvidence": { "type": "array" }, "provenance": { "type": "object" }, "attachments": { "type": "array" }, "status": { "enum": ["ACTIVE", "ARCHIVED", "DELETED"] }, "scope": { "enum": ["GLOBAL", "PROJECT"] }, "projectId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "tags": { "type": "array" }, "contentHash": { "$ref": "#/$defs/hash" }, "createdAt": { "$ref": "#/$defs/instant" }, "updatedAt": { "$ref": "#/$defs/instant" }, "schemaVersion": { "$ref": "#/$defs/revision" }, "history": { "type": "array" } } },
    "memory": { "type": "object", "additionalProperties": false, "required": ["id", "title", "body", "scope", "scopeId", "source", "sourceStableId", "sourceSummary", "status", "contentHash", "conceptHash", "createdAt", "updatedAt", "lastConfirmedAt", "deletedAt", "schemaVersion", "history"], "properties": { "id": { "$ref": "#/$defs/id" }, "title": { "type": "string" }, "body": { "type": "string" }, "scope": { "enum": ["GLOBAL", "PROJECT", "CONVERSATION"] }, "scopeId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "source": { "enum": ["USER_CONFIRMED", "MANUAL_IMPORT"] }, "sourceStableId": { "type": "string" }, "sourceSummary": { "type": "string" }, "status": { "enum": ["ACTIVE", "PAUSED", "DELETED"] }, "contentHash": { "$ref": "#/$defs/hash" }, "conceptHash": { "$ref": "#/$defs/hash" }, "createdAt": { "$ref": "#/$defs/instant" }, "updatedAt": { "$ref": "#/$defs/instant" }, "lastConfirmedAt": { "$ref": "#/$defs/instant" }, "deletedAt": { "type": ["string", "null"] }, "schemaVersion": { "$ref": "#/$defs/revision" }, "history": { "type": "array" } } },
    "relation": { "type": "object", "additionalProperties": false, "required": ["id", "type", "fromId", "toId", "scope", "projectId", "status", "createdAt", "updatedAt", "createdByIntentId", "latestIntentId", "suggestionSource", "history"], "properties": { "id": { "$ref": "#/$defs/id" }, "type": { "enum": ["RELATED", "DUPLICATE_CANDIDATE", "SUPPORTS", "CONTRADICTS"] }, "fromId": { "$ref": "#/$defs/id" }, "toId": { "$ref": "#/$defs/id" }, "scope": { "enum": ["GLOBAL", "PROJECT"] }, "projectId": { "anyOf": [{ "$ref": "#/$defs/id" }, { "type": "null" }] }, "status": { "enum": ["ACTIVE", "REVOKED"] }, "createdAt": { "$ref": "#/$defs/instant" }, "updatedAt": { "$ref": "#/$defs/instant" }, "createdByIntentId": { "$ref": "#/$defs/id" }, "latestIntentId": { "$ref": "#/$defs/id" }, "suggestionSource": { "enum": ["MANUAL", "P4F_DEDUPLICATION_CANDIDATE"] }, "history": { "type": "array" } } },
    "settings": { "type": "object", "additionalProperties": false, "required": ["uiLanguage", "theme"], "properties": { "uiLanguage": { "type": "string" }, "theme": { "enum": ["SYSTEM", "LIGHT", "DARK"] } } }
  }
}
