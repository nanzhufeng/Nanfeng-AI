{
  "identifier": "main-capability",
  "description": "P6-G permits only local window basics, typed workspace commands, owner-local search/history/previews, and safe catalog/default/conversation-route metadata. It grants no credential, transport, prompt, invocation or executor access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "allow-stage-preflight-selected-exchange",
    "allow-import-staged-exchange-as-new-workspace",
    "allow-list-desktop-workspaces",
    "allow-read-desktop-workspace",
    "allow-export-desktop-workspace-to-selected-path",
    "allow-mutate-desktop-domain",
    "allow-import-desktop-conversation-attachment",
    "allow-desktop-temporary-conversation",
    "allow-desktop-domain-history",
    "allow-upsert-desktop-model-metadata",
    "allow-desktop-p6g-model-selection",
    "allow-inspect-p8-agent-runs",
    "allow-read-dual-path-status",
    "allow-p6e-temporary-maintenance-acceptance",
    "allow-p6h-chatgpt-export-import",
    "allow-p6i-claude-export-import",
    "allow-p6j-nanfeng-knowledge-export-import",
    "allow-p6k-zip-import",
    "allow-search-desktop-local-index",
    "allow-read-desktop-local-search-history",
    "allow-clear-desktop-local-search-history",
    "allow-read-desktop-image-preview",
    "allow-read-desktop-pdf-preview",
    "allow-read-desktop-video-preview",
    "allow-read-desktop-audio-preview",
    "allow-read-desktop-text-preview"
  ]
}
